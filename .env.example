# =====================================================================
# Nexus Map — variáveis de ambiente
# Copie para ".env" (que NÃO é versionado) e preencha.
# Detalhes de cada credencial: README.md > "Variáveis de ambiente".
# =====================================================================

# ---------------------------------------------------------------------
# NAVEGADOR — variáveis VITE_* são embutidas no bundle do cliente.
# Não são segredos: proteja-as com restrições no Google Cloud Console.
# ---------------------------------------------------------------------
# Chave da Maps JavaScript API.
# Restrições recomendadas: "Sites" (HTTP referrers) = seus domínios;
# "Restringir chave" = somente "Maps JavaScript API".
VITE_GOOGLE_MAPS_BROWSER_KEY=
# Map ID (Google Cloud Console > Map Management) do tipo JavaScript,
# renderização VETORIAL. Necessário para marcadores avançados, mapa
# vetorial nítido e o modo 3D.
VITE_GOOGLE_MAPS_MAP_ID=
# Base da API. Vazio = mesmo host (em dev o Vite faz proxy de /api).
VITE_API_BASE_URL=

# ---------------------------------------------------------------------
# SERVIDOR — segredos. Nunca use o prefixo VITE_ nestas variáveis.
# ---------------------------------------------------------------------
PORT=8787
# Origem permitida para CORS (só necessário se cliente e API estiverem
# em hosts diferentes). Vazio = sem CORS.
CORS_ORIGIN=

# Chave server-side do Google Maps Platform. APIs a habilitar e permitir
# nesta chave: Routes API, Places API (New), Time Zone API, Geocoding API.
# Restrição recomendada: endereços IP do servidor.
GOOGLE_MAPS_SERVER_KEY=
GOOGLE_LANGUAGE_CODE=pt-BR
GOOGLE_REGION_CODE=BR
# Recursos que elevam a chamada da Routes API ao SKU Enterprise.
# Desligar = sem cores de trânsito na rota / sem informação de pedágio.
ROUTES_TRAFFIC_ON_POLYLINE=true
ROUTES_TOLLS=true

# Voos — FlightAware AeroAPI v4 (https://www.flightaware.com/aeroapi/).
# Vazio = modo avião indisponível ("não configurado"); nada é simulado.
FLIGHTAWARE_AEROAPI_KEY=
# Plano Personal: 10 result sets por minuto.
AEROAPI_MAX_REQUESTS_PER_MINUTE=10
# Regra de economia de consultas pagas (NÃO é um critério aeronáutico):
# abaixo desta distância em linha reta a busca de voos não é feita.
FLIGHT_MIN_DISTANCE_KM=100
# Raio de busca de aeroportos com voos regulares a partir da origem/destino.
FLIGHT_AIRPORT_SEARCH_RADIUS_KM=120
# Quantos aeroportos por lado entram na busca (pares = N x N consultas).
FLIGHT_MAX_AIRPORTS_PER_SIDE=2
# Base pública de aeroportos (domínio público).
AIRPORTS_DATA_URL=https://davidmegginson.github.io/ourairports-data/airports.csv
AIRPORTS_CACHE_DIR=.cache

# Semáforos
# Localização (OpenStreetMap highway=traffic_signals via Overpass API).
SIGNALS_OSM_ENABLED=true
OVERPASS_API_URL=https://overpass-api.de/api/interpreter
# Telemetria real de Hamburgo (Traffic Lights Data, SensorThings + MQTT).
SIGNALS_HAMBURG_TLD_ENABLED=true
HAMBURG_TLD_BASE_URL=https://tld.iot.hamburg.de/v1.1
HAMBURG_TLD_MQTT_URL=wss://tld.iot.hamburg.de:443/mqtt
# Rotas mais longas que isso não carregam semáforos (evita consultas grandes).
SIGNALS_MAX_ROUTE_KM=60
# Uma fase sem nova observação há mais que isso é tratada como desatualizada.
SIGNALS_STALE_AFTER_SECONDS=300
# MODO DEMONSTRAÇÃO de semáforos — dados SIMULADOS, rotulados como tal.
# Mantenha "false" em produção.
TRAFFIC_SIGNAL_DEMO_MODE=false
